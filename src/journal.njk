---
layout: layouts/base.njk
title: Journal
description: Training ideas, pro-peloton stories and race-watching notes from coach Mark Duroy.
permalink: /journal/
---
<header class="page-head">
  <div class="wrap">
    <p class="eyebrow">The Journal</p>
    <h1 class="page-head__title">Training notes from the saddle</h1>
    <p class="page-head__lede">A training idea that works, a story from the pro peloton, and what's worth watching. Written by Mark, usually on a Friday.</p>
  </div>
</header>

<section class="section section--flush-top">
  <div class="wrap">
    <div class="filters" role="group" aria-label="Filter posts by topic" data-filters hidden>
      <button type="button" class="chip" aria-pressed="true" data-filter="all">All</button>
      {%- for c in collections.categories %}
      <button type="button" class="chip" aria-pressed="false" data-filter="{{ c | slugify }}">{{ c }}</button>
      {%- endfor %}
    </div>

    {%- set featured = collections.posts[0] %}
    {%- if featured %}
    <article class="feature" data-category="{{ featured.data.category | slugify }}">
      <a class="feature__link" href="{{ featured.url }}">
        <figure class="feature__media">
          {%- if featured.data.image %}<img src="{{ featured.data.image }}" alt="{{ featured.data.image_alt }}" sizes="(min-width: 900px) 60vw, 100vw">{% endif %}
        </figure>
        <div class="feature__body">
          <p class="post-card__meta"><span>Latest · {{ featured.data.category }}</span> · <time datetime="{{ featured.date | isoDate }}">{{ featured.date | readableDate }}</time></p>
          <h2 class="feature__title">{{ featured.data.title }}</h2>
          <p>{{ featured.data.excerpt }}</p>
          <span class="link-arrow">Read the post</span>
        </div>
      </a>
    </article>
    {%- endif %}

    <div class="post-grid" data-post-grid>
      {%- for post in collections.posts %}
      {%- if not loop.first %}{% include "partials/post-card.njk" %}{% endif %}
      {%- endfor %}
    </div>
  </div>
</section>
