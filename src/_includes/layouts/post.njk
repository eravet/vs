---
layout: layouts/base.njk
bodyClass: page-post
---
<article class="post">
  <header class="post__head">
    <div class="wrap narrow">
      <p class="eyebrow"><a href="/journal/">Journal</a> · {{ category }}</p>
      <h1 class="post__title">{{ title }}</h1>
      <p class="post__lede">{{ excerpt }}</p>
      <p class="post__meta">By {{ author }} · <time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time> · {{ content | readingTime }} min read</p>
    </div>
  </header>
  {%- if image %}
  <figure class="post__hero wrap">
    <img src="{{ image }}" alt="{{ image_alt }}" loading="eager" sizes="(min-width: 1200px) 1200px, 100vw">
    {%- if image_credit %}<figcaption>{{ image_credit | renderInline | safe }}</figcaption>{% endif %}
  </figure>
  {%- endif %}
  <div class="wrap narrow prose prose--article">
    {{ content | safe }}
  </div>
  <footer class="wrap narrow post__foot">
    {%- if tags and tags.length %}
    <ul class="tag-list" aria-label="Topics">{% for t in tags %}<li>{{ t }}</li>{% endfor %}</ul>
    {%- endif %}
    <aside class="author-box">
      <img src="{{ about.photo }}" alt="" sizes="96px">
      <div>
        <p><strong>{{ site.coach }}</strong> raced professionally in Belgium and the Netherlands and now coaches riders of every level from Austin, Texas.</p>
        <p><a class="link-arrow" href="/contact/">Train with Mark</a></p>
      </div>
    </aside>
  </footer>
</article>

{%- set more = collections.posts | exclude(page.url) | limit(3) %}
<section class="section section--tint">
  <div class="wrap">
    <div class="section-head">
      <h2 class="display">More from the Journal</h2>
      <a class="link-arrow" href="/journal/">All posts</a>
    </div>
    <div class="post-grid">
      {%- for post in more %}{% include "partials/post-card.njk" %}{% endfor %}
    </div>
  </div>
</section>
